datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // Customer, Cashier, Barista, Admin, Owner
  description String?
  users       User[]
  createdAt   DateTime @default(now())
}

model User {
  id                   String                 @id @default(uuid())
  email                String                 @unique
  passwordHash         String
  name                 String
  phone                String?
  roleId               String
  role                 Role                   @relation(fields: [roleId], references: [id])
  branchId             String?
  branch               Branch?                @relation(fields: [branchId], references: [id])
  isGuest              Boolean                @default(false)
  profile              CustomerProfile?
  membership           Membership?            @relation("UserMembership")
  approvedMemberships  Membership[]           @relation("AdminApprovedMemberships")
  orders               Order[]
  favorites            Favorite[]
  reviews              Review[]
  auditLogs            AuditLog[]
  inventoryTransactions InventoryTransaction[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

model CustomerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points           Int      @default(0)
  birthDate        DateTime?
  favoriteBranchId String?
}

model Membership {
  id                         String    @id @default(uuid())
  userId                     String    @unique
  user                       User      @relation("UserMembership", fields: [userId], references: [id], onDelete: Cascade)
  campus                     String?
  status                     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason            String?   @db.Text
  approvedAt                 DateTime?
  approvedById               String?
  approvedBy                 User?     @relation("AdminApprovedMemberships", fields: [approvedById], references: [id])
  rejectedAt                 DateTime?
  whatsappConsent            Boolean   @default(true)
  promoConsent               Boolean   @default(true)
  whatsappNotificationStatus String    @default("PENDING") // PENDING, SENT, FAILED, OPT_OUT, SKIPPED
  whatsappNotificationError  String?   @db.Text
  whatsappNotifiedAt         DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
}

model PromoBroadcastLog {
  id           String   @id @default(uuid())
  broadcastDate String  // YYYY-MM-DD
  targetPhone  String
  userId       String?
  promotionId  String?
  status       String   // SENT, FAILED, SKIPPED
  errorMessage String?  @db.Text
  messageText  String   @db.Text
  createdAt    DateTime @default(now())

  @@unique([broadcastDate, targetPhone])
}

model Branch {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  address     String
  phone       String
  isActive    Boolean     @default(true)
  tables      Table[]
  users       User[]
  inventories Inventory[]
  orders      Order[]
  createdAt   DateTime    @default(now())
}

model Table {
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  number    String   // e.g. "01", "02", "VIP-1"
  capacity  Int      @default(4)
  status    String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED
  orders    Order[]
  createdAt DateTime @default(now())
}

model Category {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  icon         String?   // e.g. "coffee", "cup-soda", "cookie"
  displayOrder Int       @default(0)
  products     Product[]
}

model Product {
  id           String           @id @default(uuid())
  categoryId   String
  category     Category         @relation(fields: [categoryId], references: [id])
  name         String
  slug         String           @unique
  description  String
  basePrice    Float
  image        String
  isBestSeller Boolean          @default(false)
  isAvailable  Boolean          @default(true)
  variants     ProductVariant[]
  recipes      Recipe[]
  orderItems   OrderItem[]
  favorites    Favorite[]
  reviews      Review[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model ProductVariant {
  id              String      @id @default(uuid())
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String      // e.g. "Hot / Regular", "Iced / Large"
  priceAdjustment Float       @default(0)
  orderItems      OrderItem[]
}

model Topping {
  id         String             @id @default(uuid())
  name       String
  price      Float
  isAvailable Boolean            @default(true)
  orderItems OrderItemTopping[]
}

model Ingredient {
  id           String                 @id @default(uuid())
  name         String
  unit         String                 // ml, gram, pcs
  minimumStock Float                  @default(100)
  purchasePrice Float?               @default(0)
  supplier     String?
  expiryDate   DateTime?
  recipes      Recipe[]
  inventories  Inventory[]
}

model Recipe {
  id               String     @id @default(uuid())
  productId        String
  product          Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId     String
  ingredient       Ingredient @relation(fields: [ingredientId], references: [id])
  quantityRequired Float
}

model Inventory {
  id            String                 @id @default(uuid())
  branchId      String
  branch        Branch                 @relation(fields: [branchId], references: [id])
  ingredientId  String
  ingredient    Ingredient             @relation(fields: [ingredientId], references: [id])
  stockQuantity Float                  @default(0)
  transactions  InventoryTransaction[]
}

model InventoryTransaction {
  id          String    @id @default(uuid())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  type        String    // IN, OUT, ADJUSTMENT
  amount      Float
  notes       String?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
}

model Promotion {
  id               String   @id @default(uuid())
  title            String
  description      String
  discountType     String   @default("PERCENTAGE") // PERCENTAGE, FIXED
  discountValue    Float    @default(0)
  discountPercent  Float    @default(0)
  minPurchase      Float    @default(0)
  maxDiscount      Float?
  productId        String?
  categoryId       String?
  targetCustomerId String?
  startDate        DateTime
  endDate          DateTime
  usageLimit       Int      @default(100)
  usedCount        Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Voucher {
  id               String    @id @default(uuid())
  code             String    @unique
  discountType     String    @default("FIXED") // FIXED, PERCENTAGE
  discountAmount   Float
  minSpend         Float     @default(0)
  maxDiscount      Float?
  productId        String?
  categoryId       String?
  targetCustomerId String?
  quota            Int       @default(100)
  usedCount        Int       @default(0)
  startDate        DateTime? @default(now())
  expiryDate       DateTime
  isActive         Boolean   @default(true)
  orders           Order[]
  createdAt        DateTime  @default(now())
}

model Order {
  id                 String             @id @default(uuid())
  orderNumber        String             @unique
  branchId           String
  branch             Branch             @relation(fields: [branchId], references: [id])
  tableId            String?
  table              Table?             @relation(fields: [tableId], references: [id])
  tableNumber        String
  customerId         String?
  customer           User?              @relation(fields: [customerId], references: [id])
  customerName       String
  customerPhone      String?
  isGuest            Boolean            @default(true)
  totalAmount        Float
  discountAmount     Float              @default(0)
  voucherId          String?
  voucher            Voucher?           @relation(fields: [voucherId], references: [id])
  finalAmount        Float
  status             String             @default("WAITING") // WAITING, ACCEPTED, PROCESSING, READY, COMPLETED, CANCELLED
  cancellationReason String?
  paymentStatus      String             @default("UNPAID") // UNPAID, PAID, REFUNDED, PENDING, EXPIRED, FAILED
  paymentMethod      String             @default("PAY_AT_CASHIER") // PAY_AT_CASHIER, ONLINE_PAYMENT
  notes              String?
  items              OrderItem[]
  payment            Payment?
  history            OrderStatusHistory[]
  reviews            Review[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model OrderItem {
  id          String             @id @default(uuid())
  orderId     String
  order       Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product            @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant?    @relation(fields: [variantId], references: [id])
  productName String
  variantName String?
  unitPrice   Float
  quantity    Int
  subtotal    Float
  notes       String?
  toppings    OrderItemTopping[]
}

model OrderItemTopping {
  id          String    @id @default(uuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  toppingId   String
  topping     Topping   @relation(fields: [toppingId], references: [id])
  toppingName String
  price       Float
}

model Payment {
  id               String    @id @default(uuid())
  orderId          String    @unique
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method           String    // PAY_AT_CASHIER, ONLINE_PAYMENT
  status           String    @default("PENDING") // PENDING, PAID, FAILED, EXPIRED
  amount           Float
  paymentReference String?   @unique
  idempotencyKey   String?   @unique
  rawCallback      String?
  expiresAt        DateTime?
  paidAt           DateTime?
  receiptNumber    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model OrderStatusHistory {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String
  notes       String?
  updatedById String?
  createdAt   DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String?
  targetRole String?  // Customer, Cashier, Barista, Admin, Owner
  title      String
  message    String
  type       String   @default("INFO") // ORDER, INVENTORY, SYSTEM, PROMOTION
  link       String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  resource  String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

